rules_version = '2';

// Document shapes: schema/firestore.ts
//
// • Study content and aggregates are public and read-only (written only by
//   scripts/content/seed (npm run content:seed) and the Cloud Functions
//   backend with the admin SDK, which bypasses these rules).
// • Each learner can read and write only their own documents under
//   users/{uid}; every write is validated for shape and size.
// • Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function data() { return request.resource.data; }
    function onlyKeys(keys) { return data().keys().hasOnly(keys); }
    function isTime(v) { return v is int && v > 0; }
    function smallString(v, max) { return v is string && v.size() <= max; }

    match /meta/{docId} {
      allow read: if true;           // meta/content: the content version clients cache by
    }
    match /catalog/{docId} {
      allow read: if true;
    }
    match /subjects/{subjectId}/{document=**} {
      allow read: if true;
    }
    match /topicStats/{docId} {
      allow read: if true;
    }
    match /trending/{docId} {
      allow read: if true;
    }

    // { progress, prefs, schema, updatedAt }
    match /users/{uid} {
      function validProgress(p) {
        return p is map
          && p.keys().hasOnly(['problems', 'topics', 'revisitTopics', 'studied'])
          && p.get('problems', {}).size() <= 2000
          && p.get('topics', {}).size() <= 2000
          && p.get('revisitTopics', {}).size() <= 2000
          && p.get('studied', {}).size() <= 4000;
      }
      function validPrefs(p) {
        return p is map
          && p.keys().hasOnly(['subjectOrder', 'sort', 'interests', 'dailyGoal', 'myCourses', 'updatedAt'])
          && p.subjectOrder is list && p.subjectOrder.size() <= 200
          && p.interests is list && p.interests.size() <= 200
          && p.sort in ['default', 'custom', 'az', 'progress', 'recent']
          && (!('dailyGoal' in p) || (p.dailyGoal is int && p.dailyGoal >= 5 && p.dailyGoal <= 600))
          && (!('myCourses' in p) || (p.myCourses is list && p.myCourses.size() <= 200))
          && p.updatedAt is int;
      }

      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && onlyKeys(['progress', 'prefs', 'schema', 'updatedAt'])
        && isTime(data().updatedAt)
        && data().get('schema', 1) is int
        && (!('progress' in data()) || validProgress(data().progress))
        && (!('prefs' in data()) || validPrefs(data().prefs));

      // One study log per day: { topics, focus, updatedAt }
      match /days/{day} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && onlyKeys(['topics', 'focus', 'updatedAt'])
          && data().topics is map
          && data().topics.size() <= 500
          && data().focus is number && data().focus >= 0
          && isTime(data().updatedAt);
      }

      // Personal notes, one per topic: { key, text, updatedAt }
      match /notes/{noteId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && noteId.size() <= 200
          && onlyKeys(['key', 'text', 'updatedAt'])
          && smallString(data().key, 200)
          && smallString(data().text, 5000)
          && isTime(data().updatedAt);
      }

      // Activity events — append-only: { day, createdAt, session, client, events[] }
      match /events/{batchId} {
        allow read, delete: if isOwner(uid); // read: needed to delete them all with the account
        allow create: if isOwner(uid)
          && onlyKeys(['day', 'createdAt', 'session', 'client', 'events'])
          && data().day is string && data().day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && isTime(data().createdAt)
          && smallString(data().session, 40)
          && data().client is map && data().client.keys().hasOnly(['app', 'platform', 'width'])
          && data().events is list
          && data().events.size() > 0 && data().events.size() <= 100;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
