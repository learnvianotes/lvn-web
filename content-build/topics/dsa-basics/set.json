{"subjectId":"dsa-basics","id":"set","title":"Set","group":"","order":8,"html":"<p>1. Distinct Elements</p>\n<p>2. Unordered</p>\n<p>3. No Indexing</p>\n<p>4. Union, Intersection, set-diff are fast</p>\n<p>5. User Hashing Internally</p>\n<figure data-lang=\"py\" class=\"code\"><figcaption>Python</figcaption><pre><code>s1 = {1,2,3,4}\nprint(s1)</code></pre></figure>\n<figure data-lang=\"py\" class=\"code\"><figcaption>Python</figcaption><pre><code>s2 = ([1,2,3,4,1,2,3,4])\nprint(s2)</code></pre></figure>\n<figure data-lang=\"py\" class=\"code\"><figcaption>Python</figcaption><pre><code>s3 = {}\nprint(type(s3))</code></pre></figure>\n<figure data-lang=\"py\" class=\"code\"><figcaption>Python</figcaption><pre><code>s4 = set()\nprint(type(s4))\nprint(s4)</code></pre></figure>\n<figure data-lang=\"py\" class=\"code\"><figcaption>Python</figcaption><pre><code>s = {10, 20}\ns.add(30)\nprint(s)\n\ns.update([40, 50])\nprint(s)\n\ns.update([60, 70], {80, 90})\nprint(s)</code></pre></figure>\n<figure data-lang=\"py\" class=\"code\"><figcaption>Python</figcaption><pre><code>s = {10, 20, 30}\ns.discard(30)\nprint(s)</code></pre></figure>\n<figure data-lang=\"py\" class=\"code\"><figcaption>Python</figcaption><pre><code>s.remove(20)\nprint(s)</code></pre></figure>\n<figure data-lang=\"py\" class=\"code\"><figcaption>Python</figcaption><pre><code>s.clear()\nprint(s)\n\ns.add(50)\ndel s</code></pre></figure>\n<figure data-lang=\"py\" class=\"code\"><figcaption>Python</figcaption><pre><code>s = {10, 20, 30, 40}\nprint(len(s))\nprint(max(s))\nprint(min(s))\nprint(sum(s))\nprint(20 in s)\nprint(50 in s)</code></pre></figure>\n<figure data-lang=\"py\" class=\"code\"><figcaption>Python</figcaption><pre><code>s1 = {10, 20, 30}\ns2 = {30, 40, 50}\nprint(s1 | s2)\nprint(s1 &amp; s2)\nprint(s1 - s2)\nprint(s1 ^ s2)\n\nprint(s1.union(s2))</code></pre></figure>\n<figure data-lang=\"py\" class=\"code\"><figcaption>Python</figcaption><pre><code>s1 = {10, 20}\ns2 = {40, 30, 50}\n\nprint(s1.isdisjoint(s2))\n\nprint(s2.isdisjoint(s1))\n\nprint(s1.isdisjoint(s1))</code></pre></figure>\n<figure data-lang=\"py\" class=\"code\"><figcaption>Python</figcaption><pre><code>print(s1 &lt;=s2)\n\nprint(s1 &lt; s2)\n\nprint(s1 &gt;= s2)\n\nprint(s1 &gt; s2)</code></pre></figure>"}