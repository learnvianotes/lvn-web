{"subjectId":"javascript","id":"coding-challenges","title":"Coding Challenges","group":"Interview Prep","order":65,"html":"<p class=\"lead\">Short problems that show up again and again in JavaScript interviews — each with a clean, idiomatic solution and its complexity.</p>\n<section class=\"block\"><h3><i class=\"ti ti-letter-case\"></i>Strings</h3>\n<figure data-lang=\"js\" class=\"code\"><figcaption>JavaScript</figcaption><pre><code>const isAnagram = (a, b) =&gt; {\n  if (a.length !== b.length) return false;\n  const counts = new Map();\n  for (const ch of a) counts.set(ch, (counts.get(ch) ?? 0) + 1);\n  for (const ch of b) {\n    if (!counts.get(ch)) return false;\n    counts.set(ch, counts.get(ch) - 1);\n  }\n  return true;\n};\nconst firstUnique = (s) =&gt; {\n  const freq = {};\n  for (const ch of s) freq[ch] = (freq[ch] ?? 0) + 1;\n  return [...s].find((ch) =&gt; freq[ch] === 1) ?? null;\n};\nconst longestUniqueSubstring = (s) =&gt; {        // sliding window, O(n)\n  let best = 0, start = 0;\n  const lastSeen = new Map();\n  [...s].forEach((ch, i) =&gt; {\n    if (lastSeen.get(ch) &gt;= start) start = lastSeen.get(ch) + 1;\n    lastSeen.set(ch, i);\n    best = Math.max(best, i - start + 1);\n  });\n  return best;\n};\nconst compress = (s) =&gt; s.replace(/(.)\\1*/g, (run, ch) =&gt; ch + run.length);\n\nconsole.log(isAnagram(\"listen\", \"silent\"), isAnagram(\"rat\", \"car\"));\nconsole.log(firstUnique(\"swiss\"), longestUniqueSubstring(\"abcabcbb\"), compress(\"aaabccdddd\"));</code></pre></figure><figure data-lang=\"text\" class=\"code\"><figcaption>Output</figcaption><pre><code>true false\nw 3 a3b1c2d4</code></pre></figure>\n</section><section class=\"block\"><h3><i class=\"ti ti-brackets\"></i>Arrays</h3>\n<figure data-lang=\"js\" class=\"code\"><figcaption>JavaScript</figcaption><pre><code>const twoSum = (nums, target) =&gt; {             // O(n) with a hash map\n  const seen = new Map();\n  for (const [i, n] of nums.entries()) {\n    if (seen.has(target - n)) return [seen.get(target - n), i];\n    seen.set(n, i);\n  }\n  return null;\n};\nconst maxSubarray = (nums) =&gt; {                // Kadane, O(n)\n  let best = -Infinity, current = 0;\n  for (const n of nums) {\n    current = Math.max(n, current + n);\n    best = Math.max(best, current);\n  }\n  return best;\n};\nconst rotate = (arr, k) =&gt; {\n  k %= arr.length;\n  return [...arr.slice(-k), ...arr.slice(0, -k)];\n};\nconst missingNumber = (nums) =&gt; (nums.length * (nums.length + 1)) / 2 - nums.reduce((a, b) =&gt; a + b, 0);\nconst moveZeros = (arr) =&gt; [...arr.filter((x) =&gt; x !== 0), ...arr.filter((x) =&gt; x === 0)];\n\nconsole.log(twoSum([2, 7, 11, 15], 9), maxSubarray([-2, 1, -3, 4, -1, 2, 1, -5, 4]));\nconsole.log(rotate([1, 2, 3, 4, 5], 2), missingNumber([3, 0, 1]), moveZeros([0, 1, 0, 3, 12]));</code></pre></figure><figure data-lang=\"text\" class=\"code\"><figcaption>Output</figcaption><pre><code>[ 0, 1 ] 6\n[ 4, 5, 1, 2, 3 ] 2 [ 1, 3, 12, 0, 0 ]</code></pre></figure>\n</section><section class=\"block\"><h3><i class=\"ti ti-braces\"></i>Objects and data shaping</h3>\n<figure data-lang=\"js\" class=\"code\"><figcaption>JavaScript</figcaption><pre><code>const flattenObject = (obj, prefix = \"\") =&gt;\n  Object.entries(obj).reduce((acc, [k, v]) =&gt; {\n    const key = prefix ? `${prefix}.${k}` : k;\n    return v &amp;&amp; typeof v === \"object\" &amp;&amp; !Array.isArray(v)\n      ? { ...acc, ...flattenObject(v, key) }\n      : { ...acc, [key]: v };\n  }, {});\nconst get = (obj, path, fallback) =&gt;\n  path.split(\".\").reduce((cur, key) =&gt; cur?.[key], obj) ?? fallback;\nconst invert = (obj) =&gt; Object.fromEntries(Object.entries(obj).map(([k, v]) =&gt; [v, k]));\n\nconst config = { db: { host: \"localhost\", port: 5432 }, debug: true };\nconsole.log(flattenObject(config));\nconsole.log(get(config, \"db.port\"), get(config, \"db.user.name\", \"n/a\"));\nconsole.log(invert({ a: \"x\", b: \"y\" }));</code></pre></figure><figure data-lang=\"text\" class=\"code\"><figcaption>Output</figcaption><pre><code>{ 'db.host': 'localhost', 'db.port': 5432, debug: true }\n5432 n/a\n{ x: 'a', y: 'b' }</code></pre></figure>\n</section><section class=\"block\"><h3><i class=\"ti ti-clock\"></i>Async utilities</h3>\n<figure data-lang=\"js\" class=\"code\"><figcaption>JavaScript</figcaption><pre><code>const sleep = (ms) =&gt; new Promise((r) =&gt; setTimeout(r, ms));\n\nasync function retry(fn, { retries = 3, delay = 5 } = {}) {\n  for (let attempt = 1; ; attempt++) {\n    try {\n      return await fn(attempt);\n    } catch (err) {\n      if (attempt &gt; retries) throw err;\n      await sleep(delay * 2 ** (attempt - 1));     // exponential back-off\n    }\n  }\n}\n\nasync function mapWithConcurrency(items, limit, fn) {\n  const results = new Array(items.length);\n  let next = 0, active = 0, peak = 0;\n  async function worker() {\n    while (next &lt; items.length) {\n      const i = next++;\n      peak = Math.max(peak, ++active);\n      results[i] = await fn(items[i]);\n      active--;\n    }\n  }\n  await Promise.all(Array.from({ length: limit }, worker));\n  return { results, peak };\n}\n\nconst flaky = async (attempt) =&gt; {\n  if (attempt &lt; 3) throw new Error(`attempt ${attempt} failed`);\n  return `succeeded on attempt ${attempt}`;\n};\nconsole.log(await retry(flaky));\nconst { results, peak } = await mapWithConcurrency([1, 2, 3, 4, 5], 2, async (n) =&gt; {\n  await sleep(5);\n  return n * n;\n});\nconsole.log(results, \"max concurrent:\", peak);</code></pre></figure><figure data-lang=\"text\" class=\"code\"><figcaption>Output</figcaption><pre><code>succeeded on attempt 3\n[ 1, 4, 9, 16, 25 ] max concurrent: 2</code></pre></figure>\n</section><section class=\"block\"><h3><i class=\"ti ti-database\"></i>A tiny LRU cache</h3>\n<figure data-lang=\"js\" class=\"code\"><figcaption>JavaScript</figcaption><pre><code>class LRUCache {\n  #map = new Map();                       // Map remembers insertion order\n  constructor(capacity) { this.capacity = capacity; }\n  get(key) {\n    if (!this.#map.has(key)) return -1;\n    const value = this.#map.get(key);\n    this.#map.delete(key);                // move to most-recent position\n    this.#map.set(key, value);\n    return value;\n  }\n  put(key, value) {\n    this.#map.delete(key);\n    this.#map.set(key, value);\n    if (this.#map.size &gt; this.capacity) {\n      this.#map.delete(this.#map.keys().next().value);   // evict least recent\n    }\n  }\n  keys() { return [...this.#map.keys()]; }\n}\nconst lru = new LRUCache(2);\nlru.put(\"a\", 1);\nlru.put(\"b\", 2);\nlru.get(\"a\");\nlru.put(\"c\", 3);                          // evicts \"b\"\nconsole.log(lru.keys(), lru.get(\"b\"), lru.get(\"c\"));</code></pre></figure><figure data-lang=\"text\" class=\"code\"><figcaption>Output</figcaption><pre><code>[ 'a', 'c' ] -1 3</code></pre></figure>\n<div class=\"callout callout--note\"><div class=\"callout-label\">Key point</div><p>Talk through complexity as you go: the anagram and two-sum solutions are O(n) time / O(n) space; the LRU operations are O(1) because <code>Map</code> keeps insertion order.</p></div></section>"}