{
  "name": "learnvianotes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "content:extract": "node scripts/content/extract.mjs",
    "content:seed": "node scripts/content/seed/run.mjs",
    "emulators": "bash scripts/dev/emulators.sh",
    "functions:build": "npm --prefix functions run build",
    "deploy:rules": "firebase deploy --only firestore",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "emulators:auth": "EMULATORS=auth bash scripts/dev/emulators.sh",
    "dev:local": "vite --mode emulators --port 9091",
    "content:python": "python3 content-src/authoring/python/build.py && npm run content:extract",
    "content:seed:check": "node scripts/content/seed/run.mjs --dry-run",
    "content:seed:live": "node scripts/content/seed/run.mjs --live",
    "content:data-science": "content-src/authoring/data-science/.venv/bin/python content-src/authoring/data-science/build.py && npm run content:extract"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.474.0",
    "modern-screenshot": "^4.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "firebase-admin": "^13.10.0",
    "globals": "^15.15.0",
    "java-parser": "^2.3.4",
    "linkedom": "^0.18.13",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.4",
    "vite-plugin-pwa": "^1.3.0"
  }
}
