{
  "name": "lvn-web",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/pdfjs-assets.mjs && next dev -H 0.0.0.0 -p 3000",
    "build": "node scripts/pdfjs-assets.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:extract": "node scripts/content/extract.mjs",
    "content:check": "node scripts/content/check-code.mjs",
    "content:python": "python3 content-src/authoring/python/build.py && pnpm content:extract",
    "content:ai": "python3 content-src/authoring/artificial-intelligence/build.py && pnpm content:extract",
    "content:dsa-basics": "python3 content-src/authoring/dsa-basics/build.py && pnpm content:extract",
    "content:dsa-advanced": "python3 content-src/authoring/dsa-advanced/build.py && pnpm content:extract",
    "content:c": "python3 content-src/authoring/c/build.py && pnpm content:extract",
    "content:cpp": "python3 content-src/authoring/cpp/build.py && pnpm content:extract",
    "content:java": "python3 content-src/authoring/java/build.py && pnpm content:extract",
    "content:javascript": "python3 content-src/authoring/javascript/build.py && pnpm content:extract",
    "content:sql": "python3 content-src/authoring/sql/build.py && pnpm content:extract",
    "content:machine-learning": "content-src/authoring/data-science/.venv/bin/python content-src/authoring/machine-learning/build.py && pnpm content:extract",
    "content:deep-learning": "content-src/authoring/deep-learning/.venv/bin/python content-src/authoring/deep-learning/build.py && pnpm content:extract",
    "content:data-science": "content-src/authoring/data-science/.venv/bin/python content-src/authoring/data-science/build.py && pnpm content:extract",
    "graphql:sync": "node scripts/graphql-sync.mjs",
    "contracts:sync": "node scripts/contracts-sync.mjs",
    "codegen": "graphql-codegen --config codegen.ts",
    "graphql:check": "node scripts/graphql-check.mjs",
    "pdfjs:assets": "node scripts/pdfjs-assets.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@apollo/client": "^4.3.2",
    "@floating-ui/dom": "1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@sentry/nextjs": "11.11.0",
    "@tabler/icons-webfont": "^3.49.0",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-bubble-menu": "3.33.0",
    "@tiptap/extension-highlight": "3.33.0",
    "@tiptap/extension-subscript": "3.33.0",
    "@tiptap/extension-superscript": "3.33.0",
    "@tiptap/extensions": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "@tiptap/suggestion": "3.33.0",
    "clsx": "^2.1.1",
    "firebase": "^13.2.0",
    "graphql": "^16.14.2",
    "graphql-ws": "6.4.1",
    "highlight.js": "^11.12.0",
    "linkedom": "^0.18.15",
    "lucide-react": "^1.70.0",
    "modern-screenshot": "^4.7.0",
    "next": "^16.4.5",
    "next-intl": "^4.14.9",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "rxjs": "^7.8.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-launcher": "1.2.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "happy-dom": "^21.0.4",
    "java-parser": "^3.0.1",
    "lighthouse": "13.5.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "^8.5.23",
      "@grpc/grpc-js": "^1.13.6",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "re2js": ">=2.8.7"
    }
  }
}
