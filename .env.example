# Where study content is read from:
#   static    — JSON in public/content (works offline, no setup)
#   firestore — the Firestore database (run `npm run content:seed` first)
VITE_CONTENT_SOURCE=static

# Firebase web config (Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
