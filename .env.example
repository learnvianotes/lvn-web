# Canonical list: lvn-backend docs/architecture/env.md. Every URL lives here, never in code (lvn-backend ADR-0022).
# Copy to .env (git-ignored); put personal overrides in .env.local. Sandbox and production set these in the host.

# development | sandbox | production
NEXT_PUBLIC_APP_ENV=development
# Canonical origin for links, sitemap.xml and Open Graph. Production: https://www.learnvianotes.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Apps Script web app that appends /core feedback reports to a sheet (the old site's endpoint). Empty disables sending.
NEXT_PUBLIC_FEEDBACK_URL=https://script.google.com/macros/s/AKfycbwbtuRhZWjI0lrGsT4z1CJSbJmGIPZ8sPnI1tYUGq5WKZ-DNq-PGBAGN6CN0sa2XTwU/exec
# Optional. Version shown in the /core help centre; defaults to package.json's version.
# NEXT_PUBLIC_APP_VERSION=
