    "mono": "JetBrains Mono, ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "type": {
    "xs": { "size": 12, "line": 16, "tracking": 0 },
    "sm": { "size": 14, "line": 20, "tracking": 0 },
    "md": { "size": 16, "line": 24, "tracking": 0 },
    "lg": { "size": 18, "line": 28, "tracking": -0.1 },
    "xl": { "size": 20, "line": 28, "tracking": -0.2 },
    "2xl": { "size": 24, "line": 32, "tracking": -0.3 },
    "3xl": { "size": 30, "line": 36, "tracking": -0.4 },
    "4xl": { "size": 36, "line": 40, "tracking": -0.6 },
    "5xl": { "size": 48, "line": 52, "tracking": -0.8 }
  },
  "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 },
  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80
  },
  "radius": { "sm": 6, "md": 10, "lg": 14, "xl": 18, "2xl": 24, "pill": 999 },
  "shadow": {
    "light": {
      "sm": "0 1px 2px rgb(21 32 51 / 0.06)",
      "md": "0 4px 16px rgb(21 32 51 / 0.08)",
