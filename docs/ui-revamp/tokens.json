{
  "name": "LearnViaNotes",
  "version": 2,
  "description": "Platform-neutral design tokens for the LearnViaNotes web and mobile apps. color.base is shared paper, ink, and status. color.themes overrides the brand for each accent, in light and dark. Default mode is system. Default accent is navy. Do not introduce purple, violet, indigo, lavender, or pink.",
  "appearance": {
    "defaultMode": "system",
    "modes": ["system", "light", "dark"],
    "defaultAccent": "navy",
    "accents": ["navy", "teal", "forest", "slate", "amber"],
    "storage": {
      "mode": "cnote:theme",
      "accent": "cnote:accent"
    },
    "contrast": "WCAG AA 4.5:1 for brand on paper, brand on brandSoft, brandForeground on brand, ink on paper, and inkMuted on paper, in every accent and both color schemes."
  },
  "color": {
