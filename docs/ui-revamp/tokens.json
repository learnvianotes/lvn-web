  },
  "font": {
    "sans": "Inter, ui-sans-serif, system-ui, sans-serif",
    "mono": "JetBrains Mono, ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "type": {
    "xs": { "size": 12, "line": 16, "tracking": 0 },
    "sm": { "size": 14, "line": 20, "tracking": 0 },
    "md": { "size": 16, "line": 24, "tracking": 0 },
    "lg": { "size": 18, "line": 28, "tracking": -0.1 },
    "xl": { "size": 20, "line": 28, "tracking": -0.2 },
    "2xl": { "size": 24, "line": 32, "tracking": -0.3 },
    "3xl": { "size": 30, "line": 36, "tracking": -0.4 },
    "4xl": { "size": 36, "line": 40, "tracking": -0.6 },
    "5xl": { "size": 48, "line": 52, "tracking": -0.8 }
  },
  "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 },
  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80
  },
  "radius": { "sm": 6, "md": 10, "lg": 14, "xl": 18, "2xl": 24, "pill": 999 },
  "shadow": {
    "light": {
      "sm": "0 1px 2px rgb(21 32 51 / 0.06)",
      "md": "0 4px 16px rgb(21 32 51 / 0.08)",
      "lg": "0 12px 32px rgb(21 32 51 / 0.12)"
    },
    "dark": {
      "sm": "0 1px 2px rgb(0 0 0 / 0.35)",
      "md": "0 4px 16px rgb(0 0 0 / 0.4)",
      "lg": "0 12px 32px rgb(0 0 0 / 0.5)"
    }
  },
  "motion": {
    "fast": 120,
    "base": 180,
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "reduced": "no animation, no transition, scroll-behavior auto"
  },
  "layout": {
    "contentMax": 1152,
    "readingMax": 768,
    "sidebar": 248,
    "header": 56,
    "touchMin": 40,
    "pagePadding": 16,
    "pagePaddingDesktop": 16,
    "breakpointSm": 640,
    "breakpointMd": 768,
    "breakpointLg": 1024
  },
  "category": {
    "light": {
      "dsa": "#1e4d8c",
      "fundamentals": "#0f6b45",
      "engineering": "#0f5f6b",
      "ai": "#163e73",
      "programming": "#8a4b08"
    },
    "dark": {
      "dsa": "#9dc0ea",
      "fundamentals": "#6ee7a8",
      "engineering": "#7fd4d0",
      "ai": "#c5d9f4",
      "programming": "#f5c16c"
    }
  }
