      "brandSoft": "#1a2c44",
      "success": "#6ee7a8",
      "successSoft": "#123226",
      "warning": "#f5c16c",
      "warningSoft": "#3a2a10",
      "danger": "#f0a0a0",
      "dangerSoft": "#3a1717",
      "info": "#7fd4d0",
      "infoSoft": "#123033",
      "inverse": "#0a1018",
      "inverseInk": "#f4f7fb",
      "inverseMuted": "#c5d4e8",
