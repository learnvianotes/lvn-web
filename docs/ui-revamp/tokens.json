    "dark": {
      "paper": "#0e1520",
      "surface": "#171e28",
      "surfaceMuted": "#212a36",
      "ink": "#f4f7fb",
      "inkSecondary": "#d5deea",
      "inkMuted": "#b7c3d4",
      "line": "#2e3a4a",
      "lineStrong": "#3d4d62",
