    "defaultAccent": "ink",
    "accents": [
      "ink",
      "navy",
      "teal",
      "forest",
      "slate",
      "amber"
    ],
    "storage": {
      "mode": "cnote:theme",
      "accent": "cnote:accent"
    },
    "contrast": "WCAG AA 4.5:1 for brand on paper, brand on brandSoft, brandForeground on brand, ink on paper, and inkMuted on paper, in every accent and both color schemes."
  },
